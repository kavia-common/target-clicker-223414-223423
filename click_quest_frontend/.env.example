# Click Quest Frontend - .env.example
# Copy this file to ".env" and adjust values as needed.
# IMPORTANT: Create React App reads .env at startup. If you change any value,
# you must stop and restart the dev server (npm start) for changes to take effect.

# Backend base URL for API requests (preferred). Defaults to local backend.
# Used by src/api.js to call /api/leaderboard and /api/scores.
REACT_APP_API_BASE=http://localhost:3001

# Optional: Fallback backend URL (used only if REACT_APP_API_BASE is not set)
# REACT_APP_BACKEND_URL=http://localhost:3001

# Optional: Public URL of the frontend (useful for CORS/links in some deployments)
# REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: WebSocket URL (reserved for future features; not used currently)
# REACT_APP_WS_URL=ws://localhost:3001

# Environment and build/runtime flags (optional)
# Note: Only variables prefixed with REACT_APP_ are exposed to the browser in CRA.
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags (comma or space separated). Case-insensitive.
# Supported examples:
# - fast-score or combo: Enables combo multiplier scoring (up to x3)
# Example usage:
# REACT_APP_FEATURE_FLAGS=fast-score
REACT_APP_FEATURE_FLAGS=

# Toggle experiments if any are introduced in the future (not required)
REACT_APP_EXPERIMENTS_ENABLED=false

# React Refresh / CRA notes:
# - Do not import 'react-refresh' or '@pmmmwh/react-refresh-webpack-plugin' anywhere in src/.
# - CRA injects React Fast Refresh automatically in development.
# - As a last resort for local environment issues ONLY (e.g., ABI mismatch), you may set:
# SKIP_PREFLIGHT_CHECK=true

# Notes:
# - Backend should allow CORS from http://localhost:3000.
# - Verify backend health at: http://localhost:3001/api/health
# - After updating this file and copying to .env, restart: npm start
