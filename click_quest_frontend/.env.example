# Frontend environment variables for Click Quest (React)
# Copy this file to ".env" and adjust values as needed.
# Create React App exposes only variables prefixed with REACT_APP_

# Base URL for the backend API used by the frontend.
# Default backend port is 3001. Examples:
# - Local dev: http://localhost:3001
# - Docker/compose: http://backend:3001
REACT_APP_API_BASE=http://localhost:3001

# Optional fallback used only if REACT_APP_API_BASE is not set.
# Prefer setting REACT_APP_API_BASE instead.
REACT_APP_BACKEND_URL=

# Optional: Public URL where this frontend is served (informational).
# e.g., http://localhost:3000
REACT_APP_FRONTEND_URL=

# Reserved for future real-time features (not used currently).
REACT_APP_WS_URL=

# Optional build/runtime flags (not strictly required)
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
# JSON string for enabling specific features, e.g. {"betaLeaderboard":true}
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
